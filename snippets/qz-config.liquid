  "diagnosis": [
    { "id": "dominante", "options": [
      { "tag": "quiebre", "when": { "q": "signos", "v": "quiebre" }, "text": "Lo tuyo empieza en el quiebre: la fibra cede antes de tiempo. Trabajamos los enlaces internos en cada paso, con la mayor concentración donde más se necesita." },
      { "tag": "caida", "when": { "q": "signos", "v": "caida" }, "text": "Ves más pelo del que te parece normal. Lo más probable es que buena parte no se esté cayendo desde la raíz: se está rompiendo a media hebra. Ahí sí podemos trabajar — reforzando los enlaces internos." },
      { "tag": "frizz", "when": { "q": "signos", "v": "frizz" }, "text": "El frizz aparece cuando la cutícula se levanta. Cerramos la fibra en el enjuague y la protegemos después, para que el resultado dure entre lavados." },
      { "tag": "seco", "when": { "q": "signos", "v": "seco" }, "text": "La sequedad manda en tu caso: menos sebo, menos agua retenida. Sumamos nutrición profunda, sin siliconas que solo aparenten suavidad." },
      { "tag": "cuerpo", "when": { "q": "signos", "v": "cuerpo" }, "text": "Tu hebra está más fina que antes. Los péptidos de kiwicha, quinua y arveja aportan cuerpo al tacto para que la cola de caballo vuelva a sentirse llena." },
      { "tag": "enredo", "when": { "q": "signos", "v": "enredo" }, "text": "El enredo es fricción, y la fricción termina en quiebre: cada vez que peinas a la fuerza, pierdes hebra. Bajamos el roce en cada paso para que desenredar deje de castigarte." },
      { "tag": "opaco", "when": { "q": "signos", "v": "opaco" }, "text": "La opacidad viene de una cutícula irregular: la luz se dispersa en vez de rebotar. Al cerrarla, el brillo vuelve solo." },
      { "tag": "prevencion", "text": "Tu pelo está en el mejor momento para intervenir: las señales recién empiezan. Cuidar la fibra ahora es mucho más fácil que repararla después, cuando el daño ya se acumuló." }
    ] },
    { "id": "porosidad", "options": [
      { "when": { "q": "porosidad", "v": "alta" }, "text": "Tu respuesta sobre el shampoo solo nos dice mucho: esa aspereza es porosidad alta — la cutícula quedó abierta y el pelo pierde agua tan rápido como la absorbe. Por eso no basta con hidratar: hay que sellar." },
      { "when": { "q": "porosidad", "v": "baja" }, "text": "Tu fibra retiene bien la hidratación, así que trabajamos en mantenerla y prevenir — sin sobrecargarla con producto que no necesita." }
    ] },
    { "id": "quimico", "options": [
      { "when": { "q": "tratamientos", "v": "mechas" }, "text": "Y hay una capa que pesa más que el resto: las mechas. La decoloración abre la cutícula y rompe enlaces internos — sobre todo en el tercio superior, donde el pelo ya viene debilitado por la transición. Es daño químico acumulado: por eso tu ritual lleva sí o sí el paso de reparación profunda, y todo es color-safe para que el tono no se apague antes de tiempo." },
      { "when": { "q": "tratamientos", "v": "tinteTodo" }, "text": "Al teñir todo el largo sumas daño químico y porosidad en cada aplicación. Tu ritual es color-safe: limpia y repara sin arrastrar el tono, para que el retoque te dure más." },
      { "when": { "q": "tratamientos", "v": "tinteRaices" }, "text": "El retoque de raíces castiga menos que el color completo, pero se acumula. Todo lo que te damos es color-safe: cuida el tono mientras repara la fibra." },
      { "when": { "q": "tratamientos", "v": "canas" }, "text": "El pelo con canas es naturalmente más poroso y áspero: absorbe distinto y se enreda más. Tu ritual trabaja esa porosidad para devolverle suavidad y luz, sin cubrir nada." }
    ] },
    { "id": "textura", "options": [
      { "when": { "q": "tipo", "v": "crespo" }, "text": "Tu textura crespa además necesita más agua y más lípidos que cualquier otra: el rizo cerrado hace que el sebo natural no baje por la hebra. Por eso la nutrición pesa más en tu ritual." },
      { "when": { "q": "tipo", "v": "rizado" }, "text": "En pelo rizado la cutícula está naturalmente más abierta en las curvas, así que pierde agua más rápido y el rizo se desdefine. Trabajamos en cerrar y sellar para que el rizo aguante." }
    ] },
    { "id": "keratina", "options": [
      { "when": { "q": "tratamientos", "v": "keratina" }, "text": "Y como tienes keratina o alisado vigente, formulamos sin sulfatos: son los que arrastran el tratamiento y te acortan su duración." }
    ] },
    { "id": "cuero", "options": [
      { "when": { "q": "cuero", "v": "calor" }, "text": "Con calor casi a diario, la protección térmica no es opcional — es lo que evita que el daño se acumule cada mañana." },
      { "when": { "q": "cuero", "v": "graso" }, "text": "Tu cuero produce grasa rápido, así que la limpieza tiene que ser suave pero efectiva: sin sulfatos que resequen y disparen aún más la producción de sebo." },
      { "when": { "q": "cuero", "v": "seco" }, "text": "Tu cuero se siente seco o sensible — algo muy común en la transición. La niacinamida y el romero dan confort sin cargar la raíz." }
    ] },
    { "id": "etapa", "options": [
      { "when": { "q": "momento", "v": "sensible" }, "text": "Y como vienes de un tratamiento, todo lo que te recomendamos pasa nuestros filtros: sin disruptores endocrinos ni fitoestrógenos." }
    ] }
  ],
