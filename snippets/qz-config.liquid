  "tools": {
    "max": 3,
    "items": [
      { "key": "peine", "bg": "#F4EFE9", "when": { "q": "signos", "v": "enredo" }, "why": "Se te enreda: el acetato desliza sin tirar ni cargar estática, incluso en mojado." },
      { "key": "toalla", "bg": "#ECEFEA", "when": { "any": [ { "q": "signos", "v": "frizz" }, { "q": "cuero", "v": "calor" } ] }, "why": "El algodón raspa la cutícula y dispara el frizz. La microfibra waffle absorbe con menos fricción." },
      { "key": "gorro", "bg": "#EDEFEC", "when": { "any": [ { "product": "masc" }, { "q": "signos", "v": "seco" }, { "q": "porosidad", "v": "alta" } ] }, "why": "Potencia el tiempo de acción de La Mascarilla y cuida tu peinado entre lavados." },
      { "key": "pinzas", "bg": "#F4EFE9", "when": { "any": [ { "q": "signos", "v": "quiebre" }, { "q": "grosor", "v": "fino" } ] }, "why": "El metal y el plástico duro doblan y parten la hebra frágil. El acetato sujeta firme, sin marca." }
    ],
    "fallback": { "key": "peine", "bg": "#F4EFE9", "why": "Desenreda sin romper — la herramienta base de cualquier ritual." }
  }
}
