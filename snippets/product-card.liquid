{%- comment -%}
  Tarjeta de producto del cuarteto (Home, Productos, relacionados).
  Uso:
    {% render 'product-card', product: p, button_label: 'Añadir al ritual', solid: false, image_label: 'El Shampoo · foto de producto' %}
  - La foto y el nombre llevan a la ficha; el botón añade al carrito sin salir.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign label = button_label | default: 'Añadir al ritual'
  assign num = ''
  capture num
    render 'product-field', product: product, field: 'number'
  endcapture
-%}
<div class="pcard" style="{% render 'product-field', product: product, field: 'style' %}">
  <a href="{{ product.url }}" class="pcard__link">
    <div class="pcard__shot">
      <div class="pcard__img">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(max-width: 900px) 50vw, 25vw', loading: 'lazy', alt: product.title | escape }}
        {%- else -%}
          <div class="pcard__btl">{% render 'bottle', product: product, size: 'sm' %}</div>
        {%- endif -%}
      </div>
      {%- capture badge -%}{%- render 'product-field', product: product, field: 'badge' -%}{%- endcapture -%}
      {%- if badge != blank -%}<div class="pcard__badge">{{ badge }}</div>{%- endif -%}
      {%- if num != blank -%}<div class="pcard__num">{{ num }}</div>{%- endif -%}
    </div>
    <div class="pcard__bar"></div>
    <div class="pcard__name">{{ product.title }}</div>
    <div class="pcard__verbs">{%- render 'product-field', product: product, field: 'verbs' -%}</div>
    <div class="pcard__price">
      <span class="p">{{ variant.price | money_without_trailing_zeros }}</span>
      {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
      <span class="s">{%- render 'product-field', product: product, field: 'size' -%}</span>
    </div>
  </a>
  {%- if variant.available -%}
    <button type="button" class="addbtn{% if solid %} addbtn--solid{% endif %}" data-add-to-cart="{{ variant.id }}" data-added-label="Añadido ✓">{{ label }}</button>
  {%- else -%}
    <button type="button" class="addbtn" disabled>Agotado</button>
  {%- endif -%}
</div>
