  case field
    when 'key'
      echo d_key
    when 'short'
      echo mf.short_name.value | default: d_short
    when 'stage_bg'
      echo mf.stage_bg.value | default: d_stage
    when 'soft_bg'
      echo mf.soft_bg.value | default: d_soft
    when 'tagline'
      echo mf.tagline.value | default: d_tagline
    when 'hero'
      echo mf.hero_signal.value | default: d_hero
    when 'level'
      assign lv = mf.levels.value[signal]
      if lv == blank
        assign needle = ',' | append: signal | append: ':'
        assign parts = d_levels | split: needle
        if parts.size > 1
          assign lv = parts[1] | split: ',' | first
        endif
      endif
      echo lv | default: 'otro'
    when 'desc'
      echo mf.short_description.value | default: d_desc
    when 'benefits'
      if mf.benefits.value != blank
        echo mf.benefits.value | join: '~~'
      else
        echo d_benefits
      endif
    when 'loves'
      if mf.loves.value != blank
        for l in mf.loves.value
          unless forloop.first
            echo '~~'
          endunless
          echo l.t | append: '^^' | append: l.s | append: '^^'
          if l.seal
            echo '1'
          else
            echo '0'
          endif
        endfor
      else
        echo d_loves
      endif
    when 'actives'
      if mf.actives.value != blank
        for l in mf.actives.value
          unless forloop.first
            echo '~~'
          endunless
          echo l.n | append: '^^' | append: l.name | append: '^^' | append: l.inci | append: '^^' | append: l.role
        endfor
      else
        echo d_actives
      endif
    when 'inci'
      echo mf.inci.value | default: d_inci
    when 'ritual_title'
      echo mf.ritual_title.value | default: d_ritual
    when 'steps'
      if mf.how_to.value != blank
        echo mf.how_to.value | join: '~~'
      else
        echo d_steps
      endif
    when 'tip'
      echo mf.tip.value | default: d_tip
    when 'faqs'
      if mf.faqs.value != blank
        for f in mf.faqs.value
          unless forloop.first
            echo '~~'
          endunless
          echo f.q | append: '^^' | append: f.a
        endfor
      else
        echo d_faqs
      endif
    when 'rec_tool'
      echo mf.recommended_tool.value.handle | default: d_rec
    when 'mat'
      echo mf.material.value | default: d_mat
    when 'why'
      echo mf.why.value | default: d_why
    when 'swatch'
      echo mf.swatch.value | default: d_swatch
  endcase
-%}
