  assign d_levels = ''
  assign d_desc = ''
  assign d_benefits = ''
  assign d_loves = ''
  assign d_actives = ''
  assign d_inci = ''
  assign d_ritual = ''
  assign d_steps = ''
  assign d_tip = ''
  assign d_faqs = ''
  assign d_rec = ''
