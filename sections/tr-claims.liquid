{{ 'tr.css' | asset_url | stylesheet_tag }}
<div class="tr-claims">
  <div class="wrap tr-w1080 tr-claims__inner">
    <div class="tr-claims__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tr-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="tr-claims__list">
      {%- for block in section.blocks -%}
        <div class="tr-claims__row" {{ block.shopify_attributes }}>
          <div class="tr-claims__title">{{ block.settings.title }}</div>
          <p class="tr-claims__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
      <div class="tr-claims__ctas">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_url | default: routes.all_products_collection_url }}" class="btn btn--solid">{{ section.settings.btn1_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_url | default: '/pages/nosotros' }}" class="btn btn--line">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Transp. · No decimos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "LO QUE NO DECIMOS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Ser transparente también es no exagerar." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "btn1_label", "label": "Botón 1 · texto", "default": "CONOCE LA LÍNEA" },
    { "type": "url", "id": "btn1_url", "label": "Botón 1 · enlace", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Botón 2 · texto", "default": "QUIÉNES SOMOS" },
    { "type": "url", "id": "btn2_url", "label": "Botón 2 · enlace", "info": "Por defecto: /pages/nosotros" }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Afirmación",
      "settings": [
        { "type": "text", "id": "title", "label": "Lo que no decimos", "default": "No decimos «cancer-free»." },
        { "type": "textarea", "id": "text", "label": "Explicación", "default": "Excluimos ingredientes con clasificación de carcinogenicidad, y eso es lo que decimos. Ningún cosmético puede prometer más que eso." }
      ]
    }
  ]
}
{% endschema %}
