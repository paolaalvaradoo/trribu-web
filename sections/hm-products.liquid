{{ 'hm.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign label = section.settings.button_label | default: 'Añadir al ritual'
  assign fallback_handles = 'el-shampoo,el-acondicionador,la-mascarilla,el-acondicionador-sin-enjuague' | split: ','
-%}
<div class="hm-products" id="productos">
  <div class="wrap hm-products__inner">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="h3 hm-head__title">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_serif != blank %} <span class="hm-serif">{{ section.settings.heading_serif }}</span>{%- endif -%}
        </h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: routes.all_products_collection_url }}" class="txt-link txt-link--soft">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="hm-pills" aria-label="Filtrar productos">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" class="pill{% if block.settings.active %} is-on{% endif %}"{% if block.settings.active %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="pgrid">
      {%- if section.settings.products != blank and section.settings.products.size > 0 -%}
        {%- for p in section.settings.products -%}
          {% render 'product-card', product: p, button_label: label, solid: false %}
        {%- endfor -%}
      {%- else -%}
        {%- for h in fallback_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p.id != blank -%}
            {% render 'product-card', product: p, button_label: label, solid: false %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "El Cuarteto · productos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "El Cuarteto" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Cuatro pasos." },
    { "type": "text", "id": "heading_serif", "label": "Título · final en cursiva", "default": "Un solo sistema." },
    { "type": "text", "id": "link_label", "label": "Enlace \"ver todo\" · texto", "default": "Ver todo" },
    { "type": "url", "id": "link_url", "label": "Enlace \"ver todo\" · URL", "default": "/collections/all" },
    { "type": "product_list", "id": "products", "label": "Productos", "limit": 8, "info": "Vacío = El Shampoo, El Acondicionador, La Mascarilla y El Acondicionador Sin Enjuague." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Añadir al ritual" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Filtro",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Todo" },
        { "type": "url", "id": "url", "label": "Enlace", "default": "/collections/all" },
        { "type": "checkbox", "id": "active", "label": "Marcado (activo)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "El Cuarteto · productos",
      "blocks": [
        { "type": "pill", "settings": { "label": "Todo", "active": true } },
        { "type": "pill", "settings": { "label": "Kits" } },
        { "type": "pill", "settings": { "label": "Herramientas" } }
      ]
    }
  ]
}
{% endschema %}
