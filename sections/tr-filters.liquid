{{ 'tr.css' | asset_url | stylesheet_tag }}
<div class="tr-filters">
  <div class="wrap tr-w1080 tr-filters__inner">
    <div class="tr-filters__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow tr-filters__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tr-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="tr-p tr-filters__lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
    <div class="tr-filters__grid">
      {%- for block in section.blocks -%}
        <div class="tr-filters__item" {{ block.shopify_attributes }}>
          <div class="tr-filters__title">{{ block.settings.title }}</div>
          {%- if block.settings.quote != blank -%}<p class="tr-filters__quote">{{ block.settings.quote }}</p>{%- endif -%}
          {%- if block.settings.body != blank -%}<p class="tr-filters__body">{{ block.settings.body }}</p>{%- endif -%}
          {%- if block.settings.origin != blank -%}<p class="tr-filters__origin">{{ block.settings.origin }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Transp. · Dos filtros",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "CÓMO DECIDIMOS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Dos filtros con nombre propio." },
    { "type": "textarea", "id": "lede", "label": "Texto", "default": "Cada ingrediente pasa por los dos. Si falla uno, queda fuera — sin importar lo bien que funcione, lo que cueste o lo difícil que sea reemplazarlo." }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtro",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "El filtro de mi mamá" },
        { "type": "text", "id": "quote", "label": "Pregunta (serif itálica)", "default": "«¿Se lo daría a ella con tranquilidad?»" },
        { "type": "textarea", "id": "body", "label": "Qué cubre" },
        { "type": "textarea", "id": "origin", "label": "De dónde viene" }
      ]
    }
  ]
}
{% endschema %}
