{{ 'tr.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tr.js' | asset_url }}" defer></script>
<div class="tr-sello">
  <div class="wrap tr-w1080 tr-sello__inner">
    <div class="tr-sello__head">
      <h2 class="tr-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="tr-p">{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    {%- if section.settings.callout_title != blank or section.settings.callout_text != blank -%}
      <div class="tr-sello__callout">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><circle cx="16" cy="16" r="4.4"/><circle cx="16" cy="9.4" r="4.4"/><circle cx="16" cy="22.6" r="4.4"/><circle cx="10.3" cy="12.7" r="4.4"/><circle cx="21.7" cy="12.7" r="4.4"/><circle cx="10.3" cy="19.3" r="4.4"/><circle cx="21.7" cy="19.3" r="4.4"/></svg>
        <div>
          <div class="tr-sello__ctitle">{{ section.settings.callout_title }}</div>
          {%- if section.settings.callout_text != blank -%}<div class="tr-sello__ctext">{{ section.settings.callout_text }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="tr-acc" data-tr-acc>
      {%- for block in section.blocks -%}
        {%- liquid
          assign open = false
          if forloop.first and section.settings.first_open
            assign open = true
          endif
          assign n = forloop.index | prepend: '0' | slice: -2, 2
          if forloop.index > 99
            assign n = forloop.index
          endif
        -%}
        <div class="tr-acc__item{% if open %} is-open{% endif %}" data-tr-acc-item {{ block.shopify_attributes }}>
          <button type="button" class="tr-acc__head" data-tr-acc-btn aria-expanded="{{ open }}" aria-controls="TrAcc-{{ block.id }}">
            <span class="tr-acc__num">{{ n }}</span>
            <span class="tr-acc__title">{{ block.settings.title }}</span>
            {%- case block.settings.tag -%}
              {%- when 'seal' -%}<span class="tr-sello__tag">{{ section.settings.seal_tag }}</span>
              {%- when 'diff' -%}<span class="tr-sello__tag tr-sello__tag--diff">{{ section.settings.diff_tag }}</span>
              {%- else -%}<span class="tr-acc__notag" aria-hidden="true"></span>
            {%- endcase -%}
            <span class="tr-acc__icon" aria-hidden="true"></span>
          </button>
          <div class="tr-acc__panel" id="TrAcc-{{ block.id }}" data-tr-acc-panel{% unless open %} inert{% endunless %}>
            <div class="tr-acc__body">
              <span class="tr-acc__spacer"></span>
              <div class="tr-acc__content">
                {%- if block.settings.what != blank -%}
                  <div class="tr-sello__label">{{ section.settings.what_label }}</div>
                  <p class="tr-sello__txt">{{ block.settings.what }}</p>
                {%- endif -%}
                {%- if block.settings.why != blank -%}
                  <div class="tr-sello__label">{{ section.settings.why_label }}</div>
                  <p class="tr-sello__txt tr-sello__txt--last">{{ block.settings.why }}</p>
                {%- endif -%}
                {%- if block.settings.fine != blank -%}
                  <div class="tr-sello__fine"><p>{{ block.settings.fine }}</p></div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Transparencia · El Sello",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "El Sello TRRIBÚ" },
    { "type": "textarea", "id": "lede", "label": "Texto", "default": "Es el estándar que cumplen las cuatro fórmulas, sin excepción. También es el criterio con el que evaluamos cualquier ingrediente nuevo antes de que entre." },
    { "type": "text", "id": "callout_title", "label": "Recuadro · título", "default": "Seis familias en el envase, diez en esta página" },
    { "type": "richtext", "id": "callout_text", "label": "Recuadro · texto", "default": "<p>En la etiqueta comunicamos seis, porque es lo que cabe y lo que se recuerda. Acá está la lista completa. <strong>Toca cada una para ver el detalle.</strong></p>" },
    { "type": "header", "content": "Etiquetas y rótulos" },
    { "type": "text", "id": "seal_tag", "label": "Etiqueta «en el envase»", "default": "RR⁶" },
    { "type": "text", "id": "diff_tag", "label": "Etiqueta «diferencial»", "default": "EL DIFERENCIAL" },
    { "type": "text", "id": "what_label", "label": "Rótulo «qué es»", "default": "QUÉ ES" },
    { "type": "text", "id": "why_label", "label": "Rótulo «por qué»", "default": "POR QUÉ LO EXCLUIMOS" },
    { "type": "checkbox", "id": "first_open", "label": "Primera exclusión abierta al cargar", "default": true }
  ],
  "blocks": [
    {
      "type": "exclusion",
      "name": "Exclusión",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Sin sulfatos" },
        {
          "type": "select", "id": "tag", "label": "Etiqueta", "default": "seal",
          "options": [
            { "value": "none", "label": "Ninguna" },
            { "value": "seal", "label": "En el envase (RR⁶)" },
            { "value": "diff", "label": "El diferencial" }
          ]
        },
        { "type": "textarea", "id": "what", "label": "Qué es" },
        { "type": "textarea", "id": "why", "label": "Por qué lo excluimos" },
        { "type": "textarea", "id": "fine", "label": "Letra chica (opcional)" }
      ]
    }
  ]
}
{% endschema %}
