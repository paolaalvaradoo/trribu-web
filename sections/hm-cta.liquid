{{ 'hm.css' | asset_url | stylesheet_tag }}
<div class="hm-bleed hm-cta">
  {% render 'media', image: section.settings.image, label: 'Foto a sangre · el cuarteto completo o lifestyle', sizes: '100vw', bg: '#E4DED6' %}
  <div class="hm-bleed__overlay" style="background:rgba(20,18,15,{{ section.settings.overlay | divided_by: 100.0 }})"></div>
  <div class="hm-bleed__center">
    <h2 class="hm-cta__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="hm-cta__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/pages/kits' }}" class="btn btn--white hm-cta__btn">{{ section.settings.btn_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CTA a sangre",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto a sangre", "info": "El cuarteto completo o lifestyle." },
    { "type": "range", "id": "overlay", "label": "Oscurecer foto", "min": 0, "max": 90, "step": 2, "unit": "%", "default": 56 },
    { "type": "text", "id": "heading", "label": "Título", "default": "Para nosotras. Las que cambiamos." },
    { "type": "text", "id": "subheading", "label": "Frase en cursiva", "default": "Pero no renunciamos." },
    { "type": "text", "id": "btn_label", "label": "Botón · texto", "default": "Ver los kits" },
    { "type": "url", "id": "btn_url", "label": "Botón · enlace", "info": "Vacío = /pages/kits" }
  ],
  "presets": [{ "name": "CTA a sangre" }]
}
{% endschema %}
