{{ 'hm.css' | asset_url | stylesheet_tag }}
<div class="hm-split hm-split--founder">
  <div class="hm-split__text">
    <div class="hm-split__inner">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="h2 hm-split__title hm-split__title--40">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="lede-serif hm-split__lede">{{ section.settings.lede }}</p>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="hm-split__body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.quote != blank -%}<p class="hm-split__quote">{{ section.settings.quote }}</p>{%- endif -%}
      {%- if section.settings.name != blank -%}
        <div class="hm-sign">
          <div class="hm-sign__line"></div>
          <div>
            <div class="hm-sign__name">{{ section.settings.name }}</div>
            {%- if section.settings.role != blank -%}<div class="hm-sign__role">{{ section.settings.role }}</div>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_url | default: '/pages/nosotros' }}" class="btn btn--line hm-btn-14 hm-split__btn">{{ section.settings.btn_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="hm-split__media">
    {% render 'media', image: section.settings.image, label: 'Retrato de la fundadora', sizes: '(max-width: 900px) 100vw, 52vw', class: 'hm-fill' %}
  </div>
</div>

{% schema %}
{
  "name": "Split · Nosotros",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Retrato de la fundadora." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nosotros" },
    { "type": "text", "id": "heading", "label": "Título", "default": "No soy química." },
    { "type": "text", "id": "lede", "label": "Frase en cursiva", "default": "Soy la clienta." },
    { "type": "richtext", "id": "body", "label": "Texto", "default": "<p>TRRIBÚ nace de tres mujeres.</p>" },
    { "type": "textarea", "id": "quote", "label": "Cita", "default": "\"Lo que pongo en tu pelo es lo que pondría en el de mi mamá.\"" },
    { "type": "text", "id": "name", "label": "Firma · nombre", "default": "Pao" },
    { "type": "text", "id": "role", "label": "Firma · cargo", "default": "Fundadora de TRRIBÚ" },
    { "type": "text", "id": "btn_label", "label": "Botón · texto", "default": "Lee nuestra historia" },
    { "type": "url", "id": "btn_url", "label": "Botón · enlace" }
  ],
  "presets": [{ "name": "Split · Nosotros" }]
}
{% endschema %}
