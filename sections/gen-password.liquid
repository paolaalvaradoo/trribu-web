{%- comment -%}
  Prelanzamiento: wordmark, frase, registro de correo (cliente con etiqueta
  "prelanzamiento", acepta marketing) y acceso con contraseña detrás de un enlace.
{%- endcomment -%}
<div class="gen-pw">
  <div class="gen-pw__main">
    <div class="gen-pw__in">
      <div class="gen-pw__logo">{% render 'wordmark', height: section.settings.logo_height %}</div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1 gen-pw__title">{{ section.settings.title }}</h1>
      {%- if section.settings.text != blank -%}<p class="gen-lede">{{ section.settings.text }}</p>{%- endif -%}

      {%- form 'customer', id: 'PrelaunchForm' -%}
        <input type="hidden" name="contact[tags]" value="prelanzamiento">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        {%- if form.posted_successfully? -%}
          <p class="gen-msg" role="status">{{ section.settings.success }}</p>
        {%- else -%}
          {%- if form.errors -%}<div class="gen-msg gen-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="gen-pw__form">
            <label for="PrelaunchEmail" class="visually-hidden">Correo electrónico</label>
            <input id="PrelaunchEmail" class="field" type="email" name="contact[email]" placeholder="Tu correo" required autocomplete="email" autocapitalize="off" spellcheck="false">
            <button type="submit" class="btn btn--solid">{{ section.settings.button }}</button>
          </div>
          {%- if section.settings.fine != blank -%}<p class="gen-pw__fine">{{ section.settings.fine }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- assign pw_errors = false -%}
      {%- capture pw_form -%}
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            {%- assign pw_errors = true -%}
            <div class="gen-msg gen-msg--err" role="alert">Contraseña incorrecta.</div>
          {%- endif -%}
          <label for="StorePassword" class="visually-hidden">Contraseña</label>
          <input id="StorePassword" class="field" type="password" name="password" placeholder="Contraseña" autocomplete="current-password">
          <button type="submit" class="btn btn--line">Entrar</button>
        {%- endform -%}
      {%- endcapture -%}
      <div class="gen-pw__admin" id="StorePasswordBox"{% unless pw_errors %} hidden{% endunless %}>
        {{ pw_form }}
      </div>
    </div>
  </div>
  <footer class="gen-pw__foot">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · GRUPO EKKA SAC</span>
    <button type="button" class="gen-pw__toggle" aria-controls="StorePasswordBox" aria-expanded="{{ pw_errors }}"
      onclick="var b=document.getElementById('StorePasswordBox');b.hidden=!b.hidden;this.setAttribute('aria-expanded',!b.hidden);if(!b.hidden)b.querySelector('input').focus();">{{ section.settings.password_link }}</button>
  </footer>
</div>

{% schema %}
{
  "name": "Prelanzamiento",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "logo_height", "label": "Alto del logo", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Próximo lanzamiento · Perú" },
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Para el pelo que está cambiando" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Un sistema de cuidado capilar limpio para mujeres 40+. Déjanos tu correo y te avisamos primero." },
    { "type": "text", "id": "button", "label": "Botón", "default": "Avísame" },
    { "type": "text", "id": "fine", "label": "Letra chica", "default": "Solo te escribiremos sobre el lanzamiento. Puedes darte de baja cuando quieras." },
    { "type": "text", "id": "success", "label": "Mensaje de éxito", "default": "Gracias. Te avisaremos apenas abramos." },
    { "type": "text", "id": "password_link", "label": "Enlace de acceso", "default": "Acceso con contraseña" }
  ]
}
{% endschema %}
