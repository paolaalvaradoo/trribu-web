<footer class="site-footer">
  <div class="wrap footer__grid">
    <div>
      <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">{% render 'wordmark', height: 24 %}</a>
      {%- if section.settings.tagline != blank -%}<p class="footer__tag">{{ section.settings.tagline }}</p>{%- endif -%}
      {%- if section.settings.legal != blank -%}<p class="small" style="margin:0">{{ section.settings.legal }}</p>{%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      <div {{ block.shopify_attributes }}>
        <h2 class="footer__h">{{ block.settings.heading | default: menu.title }}</h2>
        <ul class="footer__list">
          {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
  <div class="wrap footer__base">
    <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</span>
    <span class="tm">{{ section.settings.signoff }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "tagline", "label": "Frase", "default": "Para el pelo que está cambiando." },
    { "type": "text", "id": "legal", "label": "Texto legal", "default": "Formulado en Lima por GRUPO EKKA SAC." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "TRRIBÚ · GRUPO EKKA SAC" },
    { "type": "text", "id": "signoff", "label": "Firma", "default": "CON TRRIBOND" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de links",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ]
}
{% endschema %}
