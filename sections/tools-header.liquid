{{ 'tools.css' | asset_url | stylesheet_tag }}
<header class="tools-hero">
  {%- if section.settings.eyebrow != blank -%}<div class="tools-hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
  <h1 class="tools-hero__title">{{ section.settings.heading }}{% if section.settings.heading_strong != blank %}<br><span class="tools-hero__strong">{{ section.settings.heading_strong }}</span>{% endif %}</h1>
  {%- if section.settings.text != blank -%}<p class="tools-hero__text">{{ section.settings.text }}</p>{%- endif -%}
</header>

{% schema %}
{
  "name": "Herramientas · cabecera",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "HERRAMIENTAS" },
    { "type": "text", "id": "heading", "label": "Título · primera línea", "default": "La fórmula es la mitad." },
    { "type": "text", "id": "heading_strong", "label": "Título · segunda línea (destacada)", "default": "La otra mitad es cómo lo tratas." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Se puede quebrar una fibra reforzada si la secas a fricción y duermes sobre algodón. Estos objetos no tienen fórmula. Tienen física." }
  ]
}
{% endschema %}
