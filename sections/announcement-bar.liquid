{%- if section.settings.text != blank -%}
  <div class="announce" role="region" aria-label="Anuncio">
    <span class="announce__txt">
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
    </span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis en pedidos desde S/ 150" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ]
}
{% endschema %}
