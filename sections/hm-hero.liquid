{{ 'hm.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign img = section.settings.image
  assign pos = nil
  if img == blank
    assign pos = '50% 22%'
  endif
  assign url1 = section.settings.btn1_url | default: routes.all_products_collection_url
  assign url2 = section.settings.btn2_url | default: settings.quiz_url
-%}
<header class="hm-bleed hm-hero">
  {%- if section.settings.use_fallback -%}
    {% render 'media', image: img, label: 'Foto editorial a sangre · mujer 40+, pelo real, luz natural', position: pos, sizes: '100vw', eager: true, fallback: 'ref-home-hero.png' %}
  {%- else -%}
    {% render 'media', image: img, label: 'Foto editorial a sangre · mujer 40+, pelo real, luz natural', position: pos, sizes: '100vw', eager: true %}
  {%- endif -%}
  <div class="veil"></div>
  <div class="hm-hero__content">
    <div class="hm-hero__inner">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow hm-hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="h1 hm-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="hm-hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="hm-hero__actions">
        {%- if section.settings.btn1_label != blank -%}<a href="{{ url1 }}" class="btn btn--white">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a href="{{ url2 }}" class="btn btn--ghost-light">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Hero a sangre",
  "tag": "section",
  "class": "hm-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto a sangre", "info": "Mujer 40+, pelo real, luz natural." },
    { "type": "checkbox", "id": "use_fallback", "label": "Usar foto de referencia si no hay imagen", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Para mujeres de 40+  ·  con TRRIBOND" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Para el pelo que está cambiando" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Tecnología que repara. Fórmula que cuida." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "btn1_label", "label": "Botón 1 · texto", "default": "Ver el sistema" },
    { "type": "url", "id": "btn1_url", "label": "Botón 1 · enlace", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Botón 2 · texto", "default": "Haz el test · 1 min" },
    { "type": "url", "id": "btn2_url", "label": "Botón 2 · enlace", "info": "Vacío = página del quiz (Configuración del tema)." }
  ],
  "presets": [{ "name": "Hero a sangre" }]
}
{% endschema %}
