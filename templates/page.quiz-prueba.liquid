  show('intro'); bar(0);
}
function show(s){ ['intro','quiz','result'].forEach(x=>document.getElementById('st-'+x).classList.toggle('on', x===s)); window.scrollTo({top:0,behavior:'smooth'}); }
function bar(p){ document.getElementById('bar').style.width = p+'%'; }

function render(){
  const q = QS[step], a = answers[q.id];
  bar(Math.round(step/QS.length*100));
  document.getElementById('steplabel').textContent = (step+1)+' / '+QS.length;
  document.getElementById('qsec').textContent = q.sec || '';
  document.getElementById('qtitle').textContent = q.title;
  document.getElementById('qhelp').textContent = q.help || '';
  document.getElementById('qhint').textContent = q.multi ? (q.max ? 'Hasta '+q.max : 'Puedes elegir varias') : '';
  document.getElementById('qnext').textContent = step===QS.length-1 ? 'VER MI RESULTADO' : 'CONTINUAR';
  document.getElementById('qskip').style.display = q.optional ? 'inline' : 'none';
  const box = document.getElementById('qopts');
  box.className = 'opts c'+q.cols;
  if(q.id==='tipo') document.getElementById('qhelp').textContent += ' · Imágenes ilustrativas provisionales.';
  const opts = ordenar(q, q.options.filter(o=>!o.showIf || o.showIf()));
  box.innerHTML = opts.map(o=>{
    const on = q.multi ? (Array.isArray(a)&&a.indexOf(o.v)>=0) : a===o.v;
    return `<div class="opt${on?' on':''}${q.img?' img':''}" data-v="${o.v}">
      ${q.img ? `<div class="pic">${o.pic}</div>` : `<div class="mark${q.multi?'':' round'}">${on?'✓':''}</div>`}
      <div><b>${o.l}</b>${o.s?`<em>${o.s}</em>`:''}</div></div>`;
  }).join('');
  const ot=q.options.find(o=>o.otro);
  if(ot && Array.isArray(a) && a.indexOf(ot.v)>=0){
    box.querySelector('.opt[data-v="'+ot.v+'"]').insertAdjacentHTML('afterend','<div class="otro-in"><input id="qotro" maxlength="80" autocomplete="off" placeholder="Escríbelo aquí (opcional)"></div>');
    const inp=document.getElementById('qotro'); inp.value=OTROS[q.id]||''; inp.oninput=()=>{ OTROS[q.id]=inp.value.slice(0,80); };
  }
  box.querySelectorAll('.opt').forEach(el=> el.onclick = ()=>pick(q, el.dataset.v));
  chk();
}
function pick(q, v){
  if(q.multi){
    let arr = Array.isArray(answers[q.id]) ? answers[q.id].slice() : [];
    const opt = q.options.find(o=>o.v===v);
    const i = arr.indexOf(v);
    if(i>=0) arr.splice(i,1);
    else if(opt.solo) arr = [v];
    else {
      arr = arr.filter(x=>{ const o=q.options.find(oo=>oo.v===x); return !(o&&o.solo); });
      if(q.max && arr.length>=q.max) return;
      arr = arr.concat(v);
    }
    answers[q.id] = arr; render(); if(opt.otro && arr.indexOf(v)>=0){ const i=document.getElementById('qotro'); if(i) i.focus(); }
  } else { answers[q.id] = v; render(); }
}
function chk(){ const q = QS[step], a = answers[q.id]; document.getElementById('qnext').disabled = q.multi ? !(a&&a.length) : !a; }
function back(){ if(step===0){ show('intro'); bar(0); return; } step--; render(); }
function advance(){ if(step >= QS.length-1){ resultado(); return; } step++; render(); }
function next(){ const q = QS[step], a = answers[q.id]; if(q.multi ? !(a&&a.length) : !a) return; advance(); }
function skip(){ delete answers[QS[step].id]; advance(); }

