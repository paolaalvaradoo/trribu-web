{% raw %}<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex"><title>TRRIBÚ · Quiz · V40</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --tinta:#2B2A2E; --tinta2:#8C887E; --linea:#E6E2DA; --linea2:#EDEAE3;
    --papel:#fff; --papel2:#FBFAF8; --gris:#A8A49B;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--papel);color:var(--tinta);font-family:'Poppins',sans-serif;font-weight:300;-webkit-font-smoothing:antialiased}
  ::selection{background:var(--tinta);color:#fff}

  nav{display:flex;align-items:center;justify-content:space-between;padding:18px 26px;border-bottom:1px solid var(--linea2)}
  .brand{font-family:'Poppins',sans-serif;font-weight:500;letter-spacing:.34em;font-size:14px}
  .tagline{font-family:Georgia,serif;font-size:14px;color:var(--tinta2);font-style:italic}

  .bar{height:2px;background:var(--linea2)}
  .bar i{display:block;height:2px;background:var(--tinta);width:0;transition:width .4s ease}

  .wrap{max-width:760px;margin:0 auto;padding:0 24px}
  .stage{display:none;animation:fade .4s ease}
  .stage.on{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  h1{font-family:Georgia,serif;font-weight:300;font-size:42px;line-height:1.12;margin:0 0 16px}
  h2{font-family:Georgia,serif;font-weight:300;font-size:30px;line-height:1.2;margin:0 0 10px}
  h3{font-family:'Poppins',sans-serif;font-weight:500;font-size:11px;letter-spacing:.2em;color:var(--tinta2);margin:0 0 14px}
  .lead{font-size:16px;line-height:1.7;color:var(--tinta2);margin:0 0 30px}
  .step-label{font-family:'Poppins',sans-serif;font-size:11px;letter-spacing:.2em;color:var(--tinta2);margin-bottom:18px}

  .opts{display:grid;gap:12px;margin-top:28px}
  .opts.c2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .opts.c3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .opt{display:flex;gap:13px;align-items:flex-start;border:1px solid var(--linea);background:var(--papel);
       padding:18px 20px;cursor:pointer;transition:all .2s ease}
  .opt:hover{border-color:var(--tinta);transform:translateY(-2px)}
  .opt.on{border-color:var(--tinta);background:var(--papel2)}
  .mark{width:20px;height:20px;flex:none;margin-top:2px;display:flex;align-items:center;justify-content:center;
        font-size:12px;border:1px solid #CFCAC0;color:#fff;transition:all .2s}
  .mark.round{border-radius:50%}
  .opt.on .mark{background:var(--tinta);border-color:var(--tinta)}
  .opt b{display:block;font-weight:500;font-size:15px;line-height:1.35}
  .opt em{display:block;font-style:normal;font-size:13px;line-height:1.5;color:var(--tinta2);margin-top:5px}

  .nav-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:34px 0 60px;flex-wrap:wrap}
  .btn{font-family:'Poppins',sans-serif;font-size:12.5px;letter-spacing:.14em;border:none;padding:15px 34px;cursor:pointer;transition:all .25s}
  .btn-solid{background:var(--tinta);color:#fff}
  .btn-solid:hover{background:#3A3630}
  .btn-solid[disabled]{background:var(--linea);color:var(--gris);cursor:default}
  .btn-line{background:none;border:1px solid var(--linea);color:var(--tinta2)}
  .btn-line:hover{background:var(--tinta);color:#fff;border-color:var(--tinta)}
  .link{background:none;border:none;font-family:'Poppins',sans-serif;font-size:12.5px;letter-spacing:.1em;color:var(--tinta2);cursor:pointer;padding:0}
  .hint{font-size:12.5px;color:var(--gris)}

  /* RESULTADO */
  .pills{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}
  .pill{border:1px solid var(--linea);padding:7px 14px;font-size:13px;color:var(--tinta2)}
  .pill.hot{background:var(--tinta);border-color:var(--tinta);color:#fff}
  .diag{font-size:15.5px;line-height:1.8;color:#3A3630}
  .sec{padding:34px 0;border-top:1px solid var(--linea2)}

  .nota{font-size:12px;line-height:1.7;color:var(--gris);padding:20px 0 60px}

  /* CAPTURA DE CORREO */
  .mailbox{border:1px solid var(--tinta);padding:30px}
  .mailrow{display:flex;gap:12px;flex-wrap:wrap}
  .mailrow input{flex:1;min-width:220px;border:1px solid var(--linea);padding:15px 16px;
    font-family:'Poppins',sans-serif;font-size:15px;color:var(--tinta);background:var(--papel);outline:none}
  .mailrow input:focus{border-color:var(--tinta)}
  .check{display:flex;align-items:center;gap:10px;margin-top:16px;cursor:pointer;font-size:14px;color:var(--tinta2)}
  .check .box{width:18px;height:18px;flex:none;border:1px solid var(--tinta);background:var(--tinta);
    color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px}
  .check .box.off{background:transparent;border-color:#CFCAC0;color:transparent}
  .mailmsg{font-size:13.5px;margin-top:16px;color:var(--tinta2);min-height:18px}

  .devtoggle{background:none;border:none;font-family:ui-monospace,monospace;font-size:11px;
    color:#C9C4B8;cursor:pointer;padding:0;margin-top:30px}
  .devbox{display:none;border:1px dashed #C9A227;background:#FFFDF5;padding:16px;margin-top:12px;
    font-family:ui-monospace,monospace;font-size:11.5px;line-height:1.7;color:#6B5A18}

  footer{border-top:1px solid var(--linea2);padding:22px;text-align:center;font-size:11.5px;color:var(--gris)}

  @media(max-width:640px){
    h1{font-size:31px}h2{font-size:25px}
    .opts.c2,.opts.c3{grid-template-columns:1fr}
    nav{flex-direction:column;gap:6px;text-align:center}
  }

  /* V4 · campos de captura */
  .field{margin-top:18px}
  .field label{display:block;font-family:'Poppins',sans-serif;font-size:10.5px;letter-spacing:.2em;color:var(--tinta2);margin-bottom:6px}
  .field input{width:100%;border:none;border-bottom:1px solid var(--tinta);padding:10px 0;background:transparent;
    font-family:'Poppins',sans-serif;font-size:16px;color:var(--tinta);outline:none}
  .field input:disabled{color:var(--tinta2)}
  .wa{display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--tinta)}
  .wa span{font-size:16px;color:var(--tinta)}
  .wa input{border-bottom:none}
  .chk{display:flex;gap:12px;align-items:flex-start;margin-top:14px;cursor:pointer;font-size:14px;line-height:1.5;color:#3A3630}
  .chk .cb{width:18px;height:18px;flex:none;margin-top:2px;border:1px solid #CFCAC0;display:flex;align-items:center;justify-content:center;font-size:11px;color:transparent}
  .chk .cb.on{background:var(--tinta);border-color:var(--tinta);color:#fff}
  .chk a{color:var(--tinta)}
  .founder{display:flex;gap:12px;margin-top:22px;padding-top:18px;border-top:1px solid var(--linea2);font-size:13.5px;line-height:1.6;color:var(--tinta2)}
  .founder .flabel{display:block;font-family:'Poppins',sans-serif;font-size:10.5px;letter-spacing:.2em;color:var(--tinta);margin-bottom:4px}

  /* V6 */
  .opt.img{flex-direction:column;align-items:stretch;gap:10px;padding:14px}
  .opt.img .pic{height:96px;background:var(--papel2);display:flex;align-items:center;justify-content:center}
  .opt.img .pic svg{height:88px;width:100%}
  .opt.img .mark{display:none}
  .opts.c4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .opts.c5{grid-template-columns:repeat(5,minmax(0,1fr))}
  .opt.img b{font-size:14px}
  @media(max-width:600px){.opts.c5,.opts.c4,.opts.c3{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .eyebrow{font-family:'Poppins',sans-serif;font-size:10.5px;letter-spacing:.24em;color:var(--tinta2);margin-bottom:10px;display:block}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:6px}
  .card{background:var(--papel2);border:1px solid var(--linea);padding:20px}
  .card b{display:block;font-weight:500;font-size:16px;margin-bottom:8px}
  .card p{margin:0;font-size:14px;line-height:1.65;color:#3A3630}
  .extra{font-size:14.5px;line-height:1.7;color:#3A3630;margin:18px 0 0} .extra b{font-weight:500;color:var(--tinta)}
  .field{margin-top:18px}
  .field label{display:block;font-family:'Poppins',sans-serif;font-size:10.5px;letter-spacing:.2em;color:var(--tinta2);margin-bottom:6px}
  .field input{width:100%;border:none;border-bottom:1px solid var(--tinta);padding:10px 0;background:transparent;font-family:'Poppins',sans-serif;font-size:16px;color:var(--tinta);outline:none}
  .field input:disabled{color:var(--tinta2)}
  .wa{display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--tinta)} .wa span{font-size:16px} .wa input{border-bottom:none}
  .chk{display:flex;gap:12px;align-items:flex-start;margin-top:14px;cursor:pointer;font-size:14px;line-height:1.5;color:#3A3630}
  .chk .cb{width:18px;height:18px;flex:none;margin-top:2px;border:1px solid #CFCAC0;display:flex;align-items:center;justify-content:center;font-size:11px;color:transparent}
  .chk .cb.on{background:var(--tinta);border-color:var(--tinta);color:#fff}
  .chk a{color:var(--tinta)}
  .legal{font-size:12px;line-height:1.6;color:var(--gris);margin-top:16px}
  .founder{display:flex;gap:12px;margin-top:22px;padding-top:18px;border-top:1px solid var(--linea2);font-size:13.5px;line-height:1.6;color:var(--tinta2)}
  .founder .flabel{display:block;font-family:'Poppins',sans-serif;font-size:10.5px;letter-spacing:.2em;color:var(--tinta);margin-bottom:4px}
  .pie{font-size:12.5px;line-height:1.7;color:var(--gris);margin-top:28px}
  /* V11 */
  .rsec{border-top:1px solid var(--linea2);padding:26px 0}
  .rsec h3{margin-bottom:14px}
  .vemos{font-family:Georgia,serif;font-size:21px;line-height:1.45;color:var(--tinta);margin:0}
  .infl{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
  .infl .card{background:#fff;padding:18px 20px}
  .infl .card b{font-size:14px;font-family:'Poppins',sans-serif}
  .infl .card p{font-size:13.5px;color:#5A564F}
  .needbox{background:var(--papel2);padding:26px 28px}
  .rhead{text-align:center;max-width:640px;margin:0 auto;padding:10px 0 22px}
  .rhead h1{margin-bottom:6px}
  .rsub{font-family:Georgia,serif;font-style:italic;font-size:22px;color:var(--tinta);margin:0 0 18px}
  .rpar{font-size:15.5px;line-height:1.75;color:#3A3630;margin:0}
  .needbox .tile{background:#fff;border:1px solid var(--linea)}
  .need p{font-size:15.5px;line-height:1.65;color:var(--tinta);margin:0 0 14px}
  .tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:14px 0 18px}
  .tile{background:var(--papel2);padding:22px 0 18px;text-align:center}
  .tile .n{font-family:'Poppins',sans-serif;font-size:30px;color:var(--tinta);line-height:1;filter:blur(1.2px)}
  .tile .blur{display:block;height:9px;width:46%;margin:10px auto 0;background:#B9B4AA;border-radius:4px;filter:blur(3px)}
  @media(max-width:600px){.tiles{grid-template-columns:repeat(2,1fr)}}

  /* LANZAMIENTO V1 */
  .ptiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0 16px}
  .pt{all:unset;box-sizing:border-box;cursor:pointer;background:#fff;border:1px solid var(--linea);padding:16px 14px 14px;display:flex;flex-direction:column;gap:6px;opacity:.55;transition:all .2s}
  .pt.on{opacity:1;border:2px solid var(--c);padding:15px 13px 13px}
  .pt .pn{align-self:flex-start;background:var(--c);color:#fff;font:600 11px 'Poppins',sans-serif;padding:3px 7px}
  .pt b{font:500 14.5px 'Poppins',sans-serif;color:var(--tinta)}
  @media(max-width:640px){.pt b{font-size:13px}.pt{padding:14px 10px 12px}.pt.on{padding:13px 9px 11px}}
  .pt small{font-size:12.5px;line-height:1.45;color:#5A564F;min-height:54px}
  .pt em{font-style:normal;font-weight:500;font-size:14px}
  .pt i{font-style:normal;font-size:11.5px;letter-spacing:.06em;color:var(--c);font-weight:600}
  .gift{background:#F6E9E5;padding:12px 14px;font-size:14px;line-height:1.5}
  .gift b{font-weight:600}
  .addmsg{font-size:13.5px;color:#5C7A3A;text-align:center;min-height:18px;margin:10px 0 0}
  @media(max-width:640px){.ptiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .spin{width:34px;height:34px;margin:0 auto;border:2px solid var(--linea);border-top-color:var(--tinta);border-radius:50%;animation:sp 0.9s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .mailbox.gate{text-align:left}
  #r-mailsec.solo{border-top:none;padding-top:30px;max-width:520px;margin:0 auto}
</style>
