    propiedades:{ quiz_version:(MODO==='launch'?'lanzamiento_v41':'prelanzamiento_v41'), quiz_fecha:new Date().toISOString(), quiz_submission_id:quizSubmissionId(), quiz_schema_version:'v33_10preguntas', quiz_scoring_version:'v38', quiz_result_needs:needsVisual(), quiz_result_findings:hallazgos(), quiz_score_mask:motor().m, quiz_score_crema:motor().c, quiz_routine_code:(!needMask&&!needCrema?'SA':needMask&&!needCrema?'SAM':!needMask&&needCrema?'SAC':'SAMC'),
      quiz_senales:answers.signos||[], quiz_porosidad:answers.porosidad||'', quiz_tratamientos:answers.tratamientos||[],
      quiz_calor:answers.calor||'', quiz_tipo:answers.tipo||'', quiz_grosor:answers.grosor||'', quiz_cuero:answers.cuero||'',
      quiz_prioridades:answers.prio||[], quiz_futuros:answers.futuros||[], quiz_edad:answers.edad||'', quiz_edad_min:({m35:0,'35':35,'40':40,'45':45,'50':50,'55':55,'60':60,'65':65})[answers.edad]??null, quiz_modo:(MODO==='launch'?'lanzamiento':'prelanzamiento'), quiz_canas:canas,
      quiz_eje:[needMask?'eje_reparacion':null, needCrema?'eje_proteccion':null].filter(Boolean),
      quiz_buyer:(pri('prevenir')||sig('bien'))?'buyer_A':'', quiz_recomendacion:rutina().map(i=>P[i].id),
      quiz_panel:cb('c4'), quiz_tags:tags } };
  return enviarAKlaviyo(payload).then(()=>{ msg.textContent = 'Tu solicitud fue recibida. Te escribiremos cuando tengamos novedades.'; msg.style.color = '#5C7A3A';
  ['nombre','mail','wa'].forEach(id=>document.getElementById(id).disabled=true);
