let step = 0, answers = {}, OTROS = {};
const ORDEN = {};  // orden barajado por sesión (excluyentes al final)
function ordenar(q, opts){
  if(!q.shuffle) return opts;
  if(!ORDEN[q.id]){
    const sh=arr=>{ for(let i=arr.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [arr[i],arr[j]]=[arr[j],arr[i]]; } return arr; };
    const frias=sh(q.options.filter(o=>!o.solo && !o.otro && !o.hot).map(o=>o.v));
    const calientes=sh(q.options.filter(o=>!o.solo && !o.otro && o.hot).map(o=>o.v));
    /* las más marcadas (hot) nunca ocupan las dos primeras posiciones */
    ORDEN[q.id]=frias.slice(0,2).concat(sh(frias.slice(2).concat(calientes)));
  }
  const pos=v=>{ const i=ORDEN[q.id].indexOf(v); return i<0?999:i; };
  return opts.slice().sort((x,y)=>(x.solo?2:x.otro?1:0)-(y.solo?2:y.otro?1:0) || pos(x.v)-pos(y.v));
}
const has = v => (answers.tratamientos||[]).indexOf(v) >= 0;
const sig = v => (answers.signos||[]).indexOf(v) >= 0;
const pri = v => (answers.prio||[]).indexOf(v) >= 0;

/* ══ MOTOR (interno, no se muestra) ══ Umbral 6 por eje. */
function motor(){
  let m=0,c=0;
  /* V35 · Auditoría de puntajes (31-oct). m = La Mascarilla · c = La Crema · umbral 6. */
  // REPARACIÓN
  if(sig('quiebre'))m+=6; if(has('mechas'))m+=6; if(has('tinteTodo'))m+=6; if(has('tinteRaices'))m+=6;
  if(has('keratina'))m+=6;                 // alisado = química + plancha >200 °C
  if(sig('secoTodo'))m+=6;                 // señal héroe de La Mascarilla
  if(sig('puntas'))m+=2; if(sig('opaco'))m+=2;
  if(answers.porosidad==='alta'){m+=6;c+=3;}
  if(answers.calor==='diario')m+=3; else if(answers.calor==='plancha')m+=2;
  if(pri('suave'))m+=3; if(pri('quiebre'))m+=3;   // deseos: suman, pero no deciden solos
  // CUIDADO SIN ENJUAGUE
  if(['frizz','pelitos','ondas','enredo','brillo'].some(pri))c+=6;
  if(pri('canas'))c+=3;
  if(sig('frizz'))c+=6; if(sig('textura'))c+=6; if(sig('enredo'))c+=6; if(sig('opaco'))c+=6;   // V38: lo que nota pesa igual que lo que desea
  if(sig('quiebre'))c+=3; if(pri('quiebre'))c+=3;
  if(answers.calor==='diario'||answers.calor==='plancha')c+=6;   // La Crema se aplica antes del calor
  if(answers.tipo==='rizado'||answers.tipo==='crespo')c+=6; else if(answers.tipo==='ondas')c+=2;
  let needMask=m>=6, needCrema=c>=6;
  // V38: si marcó «Está bastante bien», máximo UN producto extra.
  // Gana lo que ella pidió: si eligió frizz, pelitos, textura, desenredo o brillo como prioridad → La Crema; si no → La Mascarilla (prevención).
  if(sig('bien') && needMask && needCrema){
    if(['frizz','pelitos','ondas','enredo','brillo'].some(pri)) needMask=false; else needCrema=false;
  }
  return {m,c,needMask,needCrema};
}

/* ══ TAGS KLAVIYO ══ */
function segmento(){
  const t = [];
  const {needMask, needCrema} = motor();
  if(needMask)  t.push('eje_reparacion');
  if(needCrema) t.push('eje_proteccion');
  (answers.signos||[]).forEach(s=>t.push('signo_'+s));
  (answers.tratamientos||[]).forEach(s=>t.push('quim_'+s));
  if(sig('canas')) t.push(has('tinteRaices')||has('tinteTodo') ? 'canas_cubre' : 'canas_natural');
  if(answers.porosidad) t.push('poros_'+answers.porosidad);
  (answers.futuros||[]).forEach(f=>{ if(f!=='nada') t.push('futuro_'+f); });
  if(answers.calor)  t.push('calor_'+answers.calor);
  if(answers.tipo)   t.push('tipo_'+answers.tipo);
  if(answers.grosor && answers.grosor!=='nose') t.push('grosor_'+answers.grosor);
  if(answers.cuero)  t.push('cuero_'+answers.cuero);
  (answers.prio||[]).forEach(p=>t.push('prio_'+p));
  if(pri('prevenir')||sig('bien')) t.push('buyer_A');
  if(answers.edad) t.push('edad_'+answers.edad);
  t.push('rutina_'+('SA'+(needMask?'M':'')+(needCrema?'C':'')));
  t.push(MODO==='launch'?'quiz_lanzamiento':'quiz_prelanzamiento');
  return t;
}

