const NEED_LABELS = {
 proteccion:'Cuidado ante el calor', textura:'Cuidado de tu textura', canas:'Cuidado de las canas', fibra:'Cuidado de la fibra',
 reparacion:'Reparación', hidratacion:'Hidratación', suavidad:'Suavidad',
 frizz:'Control del frizz', frizz_calor:'Control del frizz y del calor', manejo:'Manejabilidad', ondas:'Definición y movimiento',
 brillo:'Brillo', volumen:'Cuerpo y volumen', cuero:'Cuidado del cuero cabelludo',
 mantenimiento:'Cuidado constante', desenredo:'Desenredado fácil', color:'Cuidado de la fibra teñida'
};
function needsVisual(){
 // Hasta tres necesidades distintas. P8 es objetivo, no prueba de síntoma.
 const n=[], poros=answers.porosidad==='alta', mm=motor();
 const add=(k)=>{if(!n.includes(k)&&n.length<3)n.push(k);};
 const chem=has('mechas')||has('tinteTodo')||has('tinteRaices');
 const dry=sig('secoTodo')||sig('puntas')||poros;
 if((chem||sig('quiebre'))&&(mm.needMask||!sig('bien')))add('reparacion');
 if(dry||pri('suave'))add('hidratacion');
 const calor=answers.calor==='diario'||answers.calor==='plancha';
 if((sig('frizz')||pri('frizz')) && mm.needCrema)add(calor?'frizz_calor':'frizz');
 if(pri('ondas')&&mm.needCrema)add('ondas');
 if(calor && mm.needCrema && !n.includes('frizz_calor'))add('proteccion');
 if((sig('enredo')||pri('enredo'))&&!n.includes('hidratacion'))add('desenredo');
 if((sig('opaco')||pri('brillo'))&&!n.includes('hidratacion'))add('brillo');
 if((sig('cuerpo')||pri('cuerpo'))&&!n.includes('hidratacion'))add('volumen');
 if((poros||pri('suave')||sig('enredo')||pri('canas'))&&n.length<3 && !n.includes('hidratacion') && !n.includes('desenredo'))add('suavidad');
 if(pri('pelitos')&&n.length<3)add('manejo');
 if(sig('textura')&&n.length<3)add('textura');
 if(sig('canas')&&n.length<3)add('canas');
 if(pri('quiebre')&&!sig('quiebre')&&n.length<3)add('fibra');
 if(pri('color')&&n.length<3)add('color');
 if((answers.cuero==='seco'||answers.cuero==='varia')&&!n.length)add('cuero');
 if(!n.length)add('mantenimiento');
 const MASC_N=['reparacion','hidratacion'], CREMA_N=['frizz','frizz_calor','ondas','proteccion','desenredo','brillo','textura','manejo'];
 const asegura=(ok,k,keep)=>{ if(ok.some(x=>n.includes(x))) return; if(n.length<3){ n.push(k); return; } for(let i=n.length-1;i>=0;i--){ if(!keep.includes(n[i])){ n[i]=k; return; } } };
 if(mm.needMask) asegura(MASC_N, (chem||sig('quiebre')||has('keratina')||pri('quiebre'))?'reparacion':'hidratacion', []);
 if(mm.needCrema) asegura(CREMA_N, calor&&(sig('frizz')||pri('frizz'))?'frizz_calor':calor?'proteccion':(sig('frizz')||pri('frizz'))?'frizz':(pri('ondas')||answers.tipo==='rizado'||answers.tipo==='crespo')?'ondas':sig('textura')?'textura':(sig('enredo')||pri('enredo'))?'desenredo':(sig('opaco')||pri('brillo'))?'brillo':pri('pelitos')?'manejo':'frizz', mm.needMask?MASC_N:[]);
 return n;
}
// V33 · Tarjetas en voz TRRIBÚ: qué le pasa a su pelo → qué necesita. Primera tarjeta = su prioridad n.º 1 (P8).
const PRIO_CARD={frizz:'frizz',pelitos:'pelitos',ondas:'ondas',suave:'poros|dry|tips',brillo:'shine',cuerpo:'body',quiebre:'break|brush',enredo:'detangle',canas:'grey',color:'chem',prevenir:'healthy'};
function hallazgos(){
 const l=[], poros=answers.porosidad==='alta';
 const put=(key,weight,title,body)=>l.push({key,weight,title,body});
 const chem=has('mechas')||has('tinteTodo')||has('tinteRaices');
 if(sig('bien')){
  if(chem||has('keratina')) put('healthy',100,'Tu pelo está bien hoy, y lo cuidas','Aunque hoy no se note, '+(has('mechas')?'las mechas le siguen':(chem?'el color le sigue':'el alisado le sigue'))+' sumando desgaste. Por eso necesita '+(motor().needMask?'reparación como prevención.':'un cuidado suave y constante en cada lavado.'));
  else put('healthy',100,'Tu pelo está bien hoy','Es el mejor momento para cuidarlo: mantener es más fácil que reparar. Necesita una rutina suave y constante.');
 }
 if(!sig('bien')){ /* con pelo «bien», el color ya va en su tarjeta */ }
 if(sig('bien')){} else if(has('mechas') && has('tinteTodo'))
  put('chem',100,'Llevas mechas y tinte','Las mechas y el tinte dejan tu pelo más frágil con cada aplicación. Por eso necesita reparación en cada lavado.');
 else if(has('mechas') && has('tinteRaices'))
  put('chem',100,'Llevas mechas y retocas tus raíces','Las mechas dejan el largo más frágil. Por eso necesita reparación en el largo y suavidad en todo el pelo.');
 else if(has('mechas'))
  put('chem',100,'Tus mechas dejan el pelo más frágil','Las mechas dejan tu pelo más frágil y áspero. Por eso necesita reparación en cada lavado.');
 else if(has('tinteTodo'))
  put('chem',93,'Llevas tinte en todo el largo','Cada aplicación de tinte reseca un poco más tu pelo, sobre todo las puntas. Por eso necesita reparación y un lavado que cuide el color.');
 else if(has('tinteRaices'))
  put('chem',85,'Retocas tus raíces','Cada retoque también toca parte del largo y lo va resecando. Por eso necesita reparación suave y un lavado que cuide el color.');
 if(sig('quiebre'))
  put('break',98,'Notas que se te cae más pelo','Mira el pelo que queda en el cepillo. Si son hebras cortas o partidas, sin la bolita blanca en la punta, es quiebre: tu pelo está frágil, y eso sí lo podemos cuidar. Si son pelos completos, con la bolita blanca de la raíz, y en cantidad, consúltalo con un dermatólogo.');
 if(pri('quiebre')&&!sig('quiebre'))
  put('brush',85,'Te preocupa el pelo que ves en el cepillo','Si son hebras cortas o partidas, sin la bolita blanca en la punta, es quiebre, y eso se puede cuidar. Si son pelos completos, con la bolita blanca de la raíz, y en cantidad, consúltalo con un dermatólogo.');
 if(poros)
  put('poros',95,'Tu pelo pierde la suavidad rápido','Tu pelo absorbe el agua rápido, pero también la pierde rápido. Por eso necesita '+(motor().needMask?'hidratación y reparación.':'hidratación en cada lavado.'));
 if(sig('secoTodo'))
  put('dry',80,'Lo sientes seco en todo el largo','Tu pelo retiene menos agua y se siente rígido. Por eso necesita hidratación en cada lavado.');
 else if(sig('puntas'))
  put('tips',80,'Tus puntas están secas','Las puntas son la parte más antigua de tu pelo y la más gastada. Por eso necesitan hidratación extra.');
 if(sig('frizz')||pri('frizz'))
  put('frizz',74,sig('frizz')?'Notas frizz':'Quieres controlar el frizz','Tu pelo está deshidratado y por eso se esponja con la humedad. Necesita hidratación y un cuidado que se quede en el pelo.');
 if(pri('pelitos')&&!sig('frizz'))
  put('pelitos',71,'Quieres que los pelitos cortos no se levanten','Pueden ser pelo nuevo o hebras que se quebraron. Necesitan hidratación y un poco de peso, sin aplastar el resto.');
 if(pri('ondas'))
  put('ondas',72,'Quieres realzar tu textura natural',answers.tipo==='lacio'?'El pelo lacio se ve mejor con movimiento y sin peso. Necesita un cuidado ligero que no lo aplaste.':'Tus ondas se definen solas cuando el pelo está hidratado y sin frizz. Necesitan un cuidado que no las endurezca.');
 else if(sig('textura'))
  put('texture',67,'Notas tu pelo con otra textura','El pelo nuevo puede nacer con otra forma. No hay que corregirlo: necesita un cuidado para la textura que tiene hoy.');
 if(answers.calor==='diario'||answers.calor==='plancha')
  put('heat',78,'Usas calor con frecuencia',motor().needMask&&motor().needCrema?'El calor frecuente reseca tu pelo y lo vuelve más frágil. No tienes que dejarlo: necesita reparación y un cuidado que lo ayude a proteger antes de usarlo.':motor().needMask?'El calor frecuente reseca tu pelo y lo vuelve más frágil. No tienes que dejarlo: solo necesita hidratación y reparación.':(motor().needCrema?'El calor frecuente reseca tu pelo. No tienes que dejarlo: solo necesita hidratación y un cuidado que lo ayude a proteger antes de usarlo.':'El calor frecuente reseca tu pelo. No tienes que dejarlo: solo necesita más hidratación.'));
 if(pri('canas')||sig('canas'))
  put('grey',63,pri('canas')?'Quieres tus canas más suaves':'Tienes canas','Las canas suelen sentirse más ásperas y brillan menos. No son un problema: solo piden suavidad y brillo.');
 if(sig('enredo')||pri('enredo'))
  put('detangle',69,sig('enredo')?'Te cuesta desenredar':'Quieres desenredar fácil','Cuando el pelo está áspero, las hebras se enganchan y se quiebran al peinarte. Necesita que el peine pase sin tirar.');
 if(sig('opaco')||pri('brillo'))
  put('shine',61,sig('opaco')?'Notas tu pelo opaco':'Buscas más brillo','Tu pelo brilla menos cuando su capa externa se abre. Necesita hidratación y un cuidado que la selle.');
 if(sig('cuerpo')||pri('cuerpo'))
  put('body',60,sig('cuerpo')?'Notas menos volumen':'Quieres más cuerpo','Cada hebra puede nacer más delgada, y los productos pesados la aplastan más. Necesita cuerpo, sin peso.');
 if(has('keratina')&&!chem&&!sig('bien'))
  put('straightening',50,'Llevas alisado o keratina','Los sulfatos acortan la duración del alisado. Por eso necesita una limpieza sin sulfatos y reparación suave.');
 if(!l.length&&sig('otro'))put('otro',10,'Nos contaste algo más','Lo leemos con atención. Mientras tanto, tu pelo necesita una rutina suave y constante.');
 if(!l.length)put('healthy',10,'Tu pelo está bien hoy','Es el mejor momento para cuidarlo: mantener es más fácil que reparar. Necesita una rutina suave y constante.');
 l.sort((x,y)=>y.weight-x.weight || x.key.localeCompare(y.key));
 // Su prioridad n.º 1 va primero, si tiene tarjeta.
 const p0=(answers.prio||[])[0];
 if(p0&&PRIO_CARD[p0]){ const keys=PRIO_CARD[p0].split('|'); const k=l.findIndex(x=>keys.includes(x.key)); if(k>0){ const [c]=l.splice(k,1); l.unshift(c);} }
 const mo=motor(), top=l.slice(0,3), resto=l.slice(3);
 const MASC_C=['chem','break','brush','poros','dry','straightening'].concat(mo.needMask?['heat','healthy']:[]), CREMA_C=['frizz','pelitos','ondas','texture','detangle','shine'].concat(mo.needCrema?['heat']:[]);
 const cubre=(keys,keep)=>{ if(top.some(x=>keys.includes(x.key))) return; const c=resto.find(x=>keys.includes(x.key)); if(!c) return;
   for(let i=top.length-1;i>=1;i--){ if(!keep.includes(top[i].key)||top.filter(x=>keep.includes(x.key)).length>1){ top[i]=c; return; } } if(top.length<3) top.push(c); };
 if(mo.needMask) cubre(MASC_C, []);
 if(mo.needCrema) cubre(CREMA_C, mo.needMask?MASC_C:[]);
 // Usa plancha o calor diario y la rutina trae La Crema: si arriba no sale la protección, la tarjeta del calor entra (nunca reemplaza su prioridad n.º 1).
 const nv=needsVisual(), hc=l.find(x=>x.key==='heat');
 if(mo.needCrema && hc && !top.includes(hc) && !nv.includes('frizz_calor') && !nv.includes('proteccion')){
   const ok=t=>(!mo.needMask||t.some(x=>MASC_C.includes(x.key)));
   for(let i=top.length-1;i>=1;i--){ const t=top.slice(); t[i]=hc; if(ok(t)){ top.splice(0,top.length,...t); break; } }
 }
 return top.map(x=>[x.title,x.body]);
}
function pintarResultado(){
 document.getElementById('tr-multi-note').hidden=(answers.signos||[]).filter(x=>x!=='bien'&&x!=='otro').length<3;
 document.getElementById('tr-needs').innerHTML=needsVisual().map(x=>'<span class="tr-need">'+NEED_LABELS[x]+'</span>').join('');
 document.getElementById('tr-tiles').innerHTML=rutina().map((_,i)=>'<div class="tr-tile"><b>'+String(i+1).padStart(2,'0')+'</b><span></span></div>').join('');
 document.getElementById('tr-tiles').style.gridTemplateColumns='repeat('+rutina().length+',1fr)';
 document.getElementById('tr-findings').innerHTML=hallazgos().map(([title,body],i)=>'<details class="tr-finding" '+(i===0?'open':'')+'><summary><span class="tr-num">'+String(i+1).padStart(2,'0')+'</span><span class="tr-ftitle">'+title+'</span><span class="tr-chevron">⌄</span></summary><div class="tr-fbody">'+body+'</div></details>').join('');
}
const SCALP={graso:'Tu cuero cabelludo se engrasa rápido: necesitas una limpieza suave que no reseque las puntas.',seco:'Tu cuero cabelludo se siente seco: necesita una limpieza suave, sin cargar la raíz.',varia:'Tu cuero cabelludo cambia de un día a otro: necesita una limpieza suave y constante.'};
function pintarCierre(){
 const sc=SCALP[answers.cuero]||'', el=document.getElementById('tr-scalp');
 el.textContent=sc; el.hidden=!sc||MODO==='launch';
 const r=rutina(), close=document.querySelector('.tr-close'), form=document.getElementById('r-mailsec');
 if(MODO!=='launch'){ close.querySelector('p').textContent='Entra a la lista y te la mandamos antes que a nadie, el día del lanzamiento.'; return; }
 const tot=r.reduce((a,i)=>a+P[i].price,0);
 close.innerHTML='<span class="eyebrow">TU RUTINA TRRIBÚ</span><h3>Esto es lo que necesita tu pelo hoy.</h3><div class="tr-prods">'+r.map(i=>{const p=P[i];return '<div class="tr-prod" style="--c:'+p.c+'"><i>'+p.n+'</i><b>'+p.name+'</b><small>'+p.size+'</small><p>'+p.why+'</p>'+(i===0&&sc?'<p class="tr-psc">'+sc+'</p>':'')+'<em>S/ '+p.price+'</em></div>';}).join('')+'</div><p class="tr-tot">Tu rutina: <b>S/ '+tot+'</b></p><p class="tr-gift"><b>De regalo:</b> La Mascarilla (100 ml) y La Crema (El Acondicionador Sin Enjuague) (50 ml) en tamaño viaje'+(r.length===4?', y La Toalla':'')+'.</p><button class="btn btn-solid tr-full" data-rutina="'+r.map(i=>P[i].id).join(',')+'" onclick="agregarAlCarrito(this)">AGREGAR MI RUTINA AL CARRITO</button>';
 form.querySelector('.eyebrow').textContent='TU RUTINA POR CORREO';
 form.querySelector('h2').textContent='¿Te la mandamos para tenerla a mano?';
 document.getElementById('btnguardar').textContent='ENVIARME MI RUTINA';
}
function resultado(){pintarResultado();pintarCierre();show('result');bar(100);}
let submissionId='';function quizSubmissionId(){if(!submissionId)submissionId='quiz_'+Date.now()+'_'+Math.random().toString(36).slice(2,10);return submissionId;}


/* ══ INTEGRACIÓN (repo trribu-quiz) · sin textos nuevos ══
   Lee /api/quiz-config: modo, precios y variantes de Shopify, URL de la política de privacidad. */
var TRRIBU_CFG=null;
function aplicarConfig(cfg){
  TRRIBU_CFG=cfg; if(!cfg) return;
  MODO=cfg.modo==='lanzamiento'?'launch':'prelaunch';
  (cfg.productos?Object.keys(cfg.productos):[]).forEach(function(k){ var p=P.find(function(x){return x.id===k;}); if(p&&typeof cfg.productos[k].precio==='number') p.price=cfg.productos[k].precio; });
  if(cfg.privacidad_url){ var a=document.querySelector('label.tr-check a'); if(a){ a.href=cfg.privacidad_url; a.target='_blank'; a.rel='noopener'; a.onclick=null; a.removeAttribute('onclick'); } }
}
if(typeof fetch==='function' && typeof location!=='undefined' && location.protocol!=='file:'){
  fetch(TRRIBU_API_BASE+'/api/quiz-config').then(function(r){return r.ok?r.json():null;}).then(aplicarConfig).catch(function(){});
}
function agregarAlCarrito(btn){
  var ids=(btn.getAttribute('data-rutina')||'').split(',').filter(Boolean);
  var cfg=TRRIBU_CFG, faltan=!cfg||!cfg.carrito_listo||ids.some(function(k){return !cfg.productos[k]||!cfg.productos[k].variant_id;});
  if(faltan){ alert('PENDIENTE FLAMA: agregar al carrito '+ids.map(function(k){return P.find(function(p){return p.id===k;}).name;}).join(' + ')); return; }
  var vars=ids.map(function(k){return cfg.productos[k].variant_id;});
  var sid=quizSubmissionId();
  var tienda=cfg.tienda;
  if(location.origin===tienda){
    // El quiz vive dentro del tema de Shopify: /cart/add.js y luego al carrito.
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:vars.map(function(v){return {id:Number(v),quantity:1};})})})
      .then(function(){return fetch('/cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attributes:{quiz_submission_id:sid}})});})
      .then(function(){location.href='/cart';});
  } else {
    // El quiz vive fuera (Vercel): permalink de carrito con el submission_id como atributo.
    location.href=tienda+'/cart/'+vars.map(function(v){return v+':1';}).join(',')+'?attributes[quiz_submission_id]='+encodeURIComponent(sid);
  }
}
