  }).catch(e=>{ err(e.message || 'No pudimos guardar tu inscripción. Intenta nuevamente.'); document.getElementById('btnguardar').disabled=false; });
}
/* Flama: configurar endpoint HTTPS en el MISMO origen; jamás colocar API privada en HTML. */
const TRRIBU_API_BASE = window.TRRIBU_API_BASE || ''; // vacío = mismo origen (Vercel); si se embebe en Shopify, la URL de Vercel
const TRRIBU_ENDPOINT = TRRIBU_API_BASE + '/api/quiz-submit';
async function enviarAKlaviyo(payload){
  if(!TRRIBU_ENDPOINT) {
    console.info('[TRRIBÚ · PROTOTIPO] Vista previa del payload:', payload);
    throw new Error('Prototipo de prueba: la inscripción todavía no está conectada a Klaviyo. Flama debe configurar el endpoint.');
  }
  const r=await fetch(TRRIBU_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  if(!r.ok) throw new Error('No pudimos guardar tu inscripción. Intenta nuevamente.');
  const data=await r.json();
  if(data && data.ok===true) return data;
  throw new Error('No se pudo confirmar la inscripción. Intenta nuevamente.');
}
