function start(){ step=0; show('quiz'); render(); }
function restart(){ submissionId='';
  step=0; answers={}; OTROS={}; for(const k in ORDEN) delete ORDEN[k];
  ['nombre','mail','wa'].forEach(id=>{ const el=document.getElementById(id); if(el){ el.value=''; el.disabled=false; }});
  ['c1','c2','c3','c4'].forEach(id=>{const el=document.getElementById(id);if(el)el.checked=false;});
  const m=document.getElementById('mailmsg'); if(m) m.textContent='';
