.invs.res .est{font:400 12.5px/1.3 var(--f);color:var(--verde)}.invs.res .mal .est{color:#7A2230}.invs.res .mal input{border-bottom-color:#7A2230}
.nota-inv{margin-top:14px;font-size:13.5px;color:var(--m)}
.banner .tx b{color:#E8BDB6}
.ios .notif{display:flex;gap:10px;align-items:center;margin:22px 14px 0;padding:10px 12px;border-radius:18px;background:rgba(255,255,255,.14);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);text-align:left;transform:translateY(-14px) scale(.94);transition:transform .8s var(--ease)}
