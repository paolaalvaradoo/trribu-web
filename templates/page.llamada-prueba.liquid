.tres .cupos{display:flex;gap:10px;margin-top:18px}.tres .cupos span{flex:1;height:52px;border:1px solid var(--c);display:grid;place-items:center;font:500 12px/1 var(--f);letter-spacing:.14em;text-transform:uppercase}
.invs{display:flex;gap:14px;margin-top:24px}
.inv{flex:1;background:var(--label);border:1px solid var(--line);padding:16px 14px 14px;min-height:124px;display:flex;flex-direction:column;gap:6px;box-shadow:0 12px 26px rgba(121,84,72,.08);transition:transform .5s var(--ease)}
.inv:nth-child(1){transform:rotate(-2.5deg)}.inv:nth-child(3){transform:rotate(2.5deg)}.inv:hover{transform:translateY(-6px)}
.inv img{height:9px;width:auto;align-self:flex-start}.inv b{font:400 20px/1.1 var(--s);margin-top:8px}
