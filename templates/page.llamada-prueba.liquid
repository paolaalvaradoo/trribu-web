.pts span:first-child{background:var(--c);height:24px}
.cola .leyenda{display:flex;justify-content:space-between;gap:16px;margin-top:12px;font:500 11.5px/1.4 var(--f);letter-spacing:.14em;text-transform:uppercase;color:var(--m)}
.falta{margin-top:38px;font-family:var(--s);font-size:clamp(22px,3vw,30px);line-height:1.35;max-width:760px}
.falta b{font-weight:400;display:inline-block;font-variant-numeric:tabular-nums}.falta b.tic{animation:tic .45s var(--ease)}
@keyframes tic{from{transform:translateY(-8px)}to{transform:none}}
.ben{margin:48px 0 44px;border-top:1px solid var(--c);max-width:720px}
