<script>
(()=>{'use strict';const $=s=>document.querySelector(s);const screens=[...document.querySelectorAll('[data-ip]')];let state='incoming',callIndex=0,waIndex=0,timer=null,callClock=0,clock=null;const phrases=['Te cuento algo…','Sabemos que tienes claro lo que quieres.','¿Y tu pelo?','Te seguimos contando por mensaje…'];const messages=['Hola, seguimos por aquí. 😉','Estamos creando algo para el pelo que está cambiando.','Todavía no podemos mostrártelo. Pero te damos una pista: son cuatro.','¿Quieres ser de las primeras en descubrirlos?'];const stop=()=>{clearTimeout(timer);timer=null};function screen(name){stop();state=name;screens.forEach(x=>x.classList.toggle('active',x.dataset.ip===name))}function enter(section){stop();clearInterval(clock);document.body.classList.remove('intro-active');$('.intro-overlay').style.display='none';document.querySelectorAll('.landing-hidden').forEach(x=>x.classList.remove('landing-hidden'));requestAnimationFrame(()=>{if(section){const target=document.getElementById(section);if(target)target.scrollIntoView({behavior:'smooth',block:'start'})}else window.scrollTo(0,0)})}function call(){screen('call');callIndex=0;callClock=0;$('#ip-quote').textContent=phrases[0];$('#ip-continue').textContent='SEGUIR ESCUCHANDO →';clearInterval(clock);clock=setInterval(()=>{callClock++;$('#ip-time').textContent='00:'+String(callClock%60).padStart(2,'0')},1000)}function nextCall(){if(callIndex<phrases.length-1){callIndex++;$('#ip-quote').textContent=phrases[callIndex];$('#ip-continue').textContent=callIndex===phrases.length-1?'VER MENSAJE →':'SEGUIR ESCUCHANDO →'}else{clearInterval(clock);screen('ended');timer=setTimeout(()=>screen('notification'),1300)}}function wa(){screen('wa');waIndex=0;$('#ip-messages').querySelectorAll('.ip-bubble').forEach(x=>x.remove());$('#ip-read').textContent='LEER MENSAJE →';$('#ip-read').disabled=false;$('#ip-typing').style.display='none'}function read(){if(waIndex===messages.length){screen('finish');return}const button=$('#ip-read'),typing=$('#ip-typing');button.disabled=true;typing.style.display='block';button.textContent='TRRIBÚ ESTÁ ESCRIBIENDO…';timer=setTimeout(()=>{typing.style.display='none';let bubble=document.createElement('div');bubble.className='ip-bubble';bubble.textContent=messages[waIndex++];$('#ip-messages').insertBefore(bubble,typing);button.disabled=false;button.textContent=waIndex===messages.length?'VER LA INVITACIÓN →':'LEER SIGUIENTE MENSAJE →'},900)}$('#answer').onclick=call;$('#reject').onclick=()=>enter();$('#hang').onclick=()=>enter();$('#ip-continue').onclick=nextCall;$('#ended-exit').onclick=()=>enter();$('#open-wa').onclick=wa;$('#ip-read').onclick=read;$('#ip-signup').onclick=()=>enter();$('#ip-discover').onclick=()=>enter();$('#hero-replay').onclick=()=>{window.scrollTo(0,0);$('.intro-overlay').style.display='flex';document.body.classList.add('intro-active');screen('incoming')};$('#ip-skip').onclick=()=>enter();const wave=$('#ip-wave');for(let i=0;i<33;i++){let b=document.createElement('i');b.style.setProperty('--h',`${6+((i*17+11)%31)}px`);b.style.setProperty('--d',`${-i*39}ms`);wave.appendChild(b)}document.body.classList.add('intro-active');
const form=$('#waitlist-form');if(form)form.addEventListener('submit',e=>{e.preventDefault();
/* PRUEBA: conecta el formulario a Klaviyo (cuenta TRRIBÚ, API pública). En producción lo conecta Flama. */
const st=$('#form-status'),btn=form.querySelector('button[type=submit]');const name=$('#name').value.trim(),email=$('#email').value.trim(),wa=$('#consent-wa').checked;
