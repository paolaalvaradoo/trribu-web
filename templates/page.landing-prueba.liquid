.then(()=>{st.textContent='Tu solicitud fue recibida. Te escribiremos cuando tengamos novedades.';form.querySelectorAll('input').forEach(x=>x.disabled=true)})
.catch(err=>{console.error(err);btn.disabled=false;st.textContent='No pudimos guardar tu inscripción. Intenta nuevamente.'})});const share=$('#share-wa');if(share)share.onclick=()=>{const t='Te paso esta llamada de TRRIBÚ. Están preparando algo para el pelo que está cambiando.';window.open('https://wa.me/?text='+encodeURIComponent(t+' '+location.href),'_blank','noopener,noreferrer')};const copy=$('#copy-link');if(copy)copy.onclick=async()=>{try{await navigator.clipboard.writeText(location.href);copy.textContent='ENLACE COPIADO'}catch(e){copy.textContent='COPIA EL ENLACE DEL NAVEGADOR'}};
})();
